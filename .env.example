# Optional. The app works fully without a key (cached and template answers).
# Server-side only. Never add a NEXT_PUBLIC_ prefix. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. If the main model is rate limited, these are tried next (each model has its own quota). Empty turns it off.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview
# Signs the session cookie that holds each visitor's payments, purchases, Spend Pause choices and goals (docs/BACKEND.md).
# Required in production, at least 32 characters, e.g. `openssl rand -base64 32`. Development derives a local one and warns.
SESSION_SECRET=
