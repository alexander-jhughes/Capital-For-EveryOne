# Optional. The app works fully without a key (cached and template answers).
# Server-side only. Never add a NEXT_PUBLIC_ prefix. Create a free key (no card) at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional. If the main model is rate limited, these are tried next (each model has its own free quota). Empty turns it off.
# GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,llama-3.1-8b-instant
# Optional. Speech-to-text model for "Clearer voice recognition" (only used after the person opts in).
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Signs the session cookie that holds each visitor's payments, purchases, Spend Pause choices and goals (docs/BACKEND.md).
# Required in production, at least 32 characters, e.g. `openssl rand -base64 32`. Development derives a local one and warns.
SESSION_SECRET=
