{
  "name": "capital-for-everyone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:browser": "npm exec --yes --package=playwright-core@1 --package=axe-core@4 -- node scripts/test-spend-pause-browser.mjs",
    "test": "vitest run",
    "test:stage6": "npm exec --yes --package=playwright-core@1 --package=axe-core@4 -- node scripts/test-stage6-browser.mjs",
    "test:pay": "npm exec --yes --package=playwright-core@1 --package=axe-core@4 -- node scripts/test-pay-browser.mjs",
    "test:backend": "npm exec --yes --package=playwright@1 -- node scripts/test-backend-browser.mjs",
    "test:product": "npm exec --yes --package=playwright@1 --package=axe-core@4 -- node scripts/test-product-browser.mjs",
    "test:voice": "npm exec --yes --package=playwright@1 --package=axe-core@4 -- node scripts/test-voice-browser.mjs",
    "test:ask": "node --no-warnings scripts/test-ask.ts",
    "test:http": "node --no-warnings scripts/test-ask-http.ts",
    "typecheck": "tsc --noEmit",
    "test:demo-users": "npm exec --yes --package=playwright@1 -- node scripts/test-demo-users-browser.mjs",
    "postinstall": "node scripts/access/copy-runtime.mjs",
    "predev": "node scripts/access/copy-runtime.mjs",
    "prebuild": "node scripts/access/copy-runtime.mjs",
    "access:index": "node --no-warnings --import ./scripts/personalisation/ts-resolve.mjs scripts/access/build-index.ts",
    "access:eval": "node --no-warnings --import ./scripts/personalisation/ts-resolve.mjs scripts/access/evaluate.ts",
    "test:access": "npm exec --yes --package=playwright@1 --package=axe-core@4 -- node scripts/test-access-browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@huggingface/transformers": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
